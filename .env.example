# ---------------------------------------------------------------------------
# BuilderLync Migration Engine - example environment
# Copy to .env. NEVER commit a populated .env (Guide §19).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Migration database (Guide §2)
DATABASE_URL=postgres://postgres@localhost:5432/builderlync_migration

# Credential encryption at rest (Guide §19, Scope §46).
# MUST decode to exactly 32 bytes. Generate with:  openssl rand -base64 32
# The service refuses to start if this is the wrong length, rather than failing
# later when a customer first connects a source.
MIGRATION_SECRET_KEY=

# Destination: which BuilderLync implementation the engine writes into.
#   in-memory = built-in mock destination (Sprint 1, tests, demo)
#   http      = real BuilderLync REST API
DESTINATION_DRIVER=in-memory
BUILDERLYNC_API_BASE_URL=
BUILDERLYNC_API_TOKEN=
BUILDERLYNC_DESTINATION_API_VERSION=v1

# Raw source payload retention in days (Scope §30)
RAW_PAYLOAD_RETENTION_DAYS=14

# Object storage for uploads / file staging (Guide §11.2)
FILE_STORAGE_ROOT=./storage

# n8n orchestrator (Guide §5)
N8N_BASE_URL=http://localhost:5678
N8N_MIGRATION_API_TOKEN=
